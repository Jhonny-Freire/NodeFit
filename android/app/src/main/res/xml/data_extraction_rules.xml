<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+. O backup automático do Android tem limite de 25 MB:
     o banco entra; as fotos ficam de fora (vão no backup ZIP do app). -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="photos/" />
    </cloud-backup>
    <device-transfer>
        <include domain="file" path="." />
        <include domain="database" path="." />
        <include domain="sharedpref" path="." />
    </device-transfer>
</data-extraction-rules>
